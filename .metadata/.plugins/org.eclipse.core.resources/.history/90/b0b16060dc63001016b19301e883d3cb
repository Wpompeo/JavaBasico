package application;

import java.util.Locale;
import java.util.Scanner;

public class vectoresOne {

	public static void main(String[] args) {

		Locale.setDefault(Locale.US);
		System.out.println("Informe o valor de repetições para o FOR: ");
		Scanner sc = new Scanner(System.in);

		int n = sc.nextInt();
		double[] vect = new double[n];

		for (int i = 0; i < n; i++) {
			System.out.println("\nInforme um número para a posição:" + i);

			vect[i] = sc.nextDouble();
		}

		double sum = 0.0;

		for (int i = 0; i < n; i++) {
			sum += vect[i];
		}
		double med = sum / n;
		System.out.println();
		System.out.println("======================================");
		System.out.println("Média dos valores informados é: " + med);
		System.out.println("======================================");

		sc.close();

	}
}
