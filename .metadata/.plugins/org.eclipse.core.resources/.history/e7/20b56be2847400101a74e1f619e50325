package application;

import java.time.Instant;
import java.time.LocalDate;
import java.time.LocalDateTime;
import java.util.Locale;

public class HourDate {
	
	public static void main (String[] args) {
		
		Locale.setDefault(Locale.US);
		
		LocalDate d01 = LocalDate.now();
		LocalDateTime d02 = LocalDateTime.now();
		Instant d03 = Instant.now();
		
		LocalDate d04 = LocalDate.parse("2025-26-07");
		
		System.out.println("Data local date: " + d01);
		System.out.println("Data local date time: " + d02);
		System.out.println("Data date GMT + 3hs: " + d03);
		System.out.println("Data date text: " + d04);
	}

}
