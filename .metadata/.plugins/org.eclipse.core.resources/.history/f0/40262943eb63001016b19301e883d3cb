package application;

import java.util.Locale;
import java.util.Scanner;

import entities.ProductsVector;

public class Products {

	public static void main(String[] args) {
		Locale.setDefault(Locale.US);
		Scanner sc = new Scanner(System.in);

		System.out.println("Informe a quantidade de produtos que deseja calcular a média de preço: ");
		int n = sc.nextInt();
		ProductsVector[] vect = new ProductsVector[n];

		for (int i = 0; i < vect.length; i++) {
			sc.nextLine();
			System.out.println("Informe o nome do produto: " + i);
			String producName = sc.nextLine();
			System.out.println("Informe o preço do produto: " + i);
			double priceProduct = sc.nextDouble();
			vect[i] = new ProductsVector(producName, priceProduct);
		}

		double soma = 0.0;
		for (int i = 0; i < vect.length; i++) {
			soma += vect[i].getPrice();
		}
		double med = soma / vect.length;

		System.out.println("======================================================");
		System.out.printf("A média dos gastos com o seus produtos será de %.2f%n: ", med);
		sc.nextLine();

		sc.close();
	}

}
