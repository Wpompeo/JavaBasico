import java.util.Scanner;

public class RevelaMaior {

	public static void main(String[] args) {

		Scanner sc = new Scanner(System.in);
		int numberOne;
		int numberTwo;
		int numberThree;
		boolean validInput = false;

		while (!validInput) {
			System.out.println("==================================");
			System.out.println("Verifica o maior número digitado!");
			System.out.println("==================================");
			System.out.println("");
			System.out.println("== Digite três números inteiros ==");
			System.out.println("");
			System.out.println("Digite o primeiro número:");
			System.out.println("Digite o segundo número:");
			System.out.println("Digite o terceiro número:");

			if (sc.hasNextInt()) {

				numberOne = sc.nextInt();
				numberTwo = sc.nextInt();
				numberThree = sc.nextInt();	
				
				int higher = max(numberOne,numberTwo, numberThree);	
				showResult(higher);
			}
		}
	}

	public static int max(int x, int y, int z) {
		int aux;

		if (x > y && x > z) {
			aux = x;

			// System.out.printf("O maior número digitado é o número 1: %d", numberOne);

		} else if (x < y && y > z) {
			aux = y;

			// System.out.printf("O maior número digitado é o número 2: %d", numberTwo);
		} else {
			aux = z;

			// System.out.printf("O maior número digitado é o número 3: %d", numberThree);
		}
		return aux;		
	}
	
	public static void showResult(int value) {
		System.out.println("=====O maior número é:=====");
		System.out.println(value);
		System.out.println("===========================");
		
	}

}
