import java.util.Locale;
import java.util.Scanner;

public class ConverterTemperature {
	
	public static void main(String[] args) {
		Locale.setDefault(Locale.US);
		Scanner sc = new Scanner(System.in);
		
		System.out.println("=======Bem vindo ao conversor de temperatura C°/F°======");
		System.out.println("Informe a temperatura atual:");
		double tempAtual = sc.nextDouble();
		converterTemp(tempAtual);
		
		sc.close();
	}
	
	public static double converterTemp(double temp) {
		
		temp = ( temp * 1.8) + 32;
		System.out.println("Sua temperatura atual convertida em F° é: " + temp + "F°");
		return temp;
	}

}
