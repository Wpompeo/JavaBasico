		Locale.setDefault(Locale.US);
		System.out.println("Informe o valor de repetições para o FOR: ");
		Scanner sc = new Scanner(System.in);

		int n = sc.nextInt();
		double[] vect = new double[n];

		for (int i = 0; i < n; i++) {
			System.out.printf("\nInforme um número para a posição %.2f%n ", + i);
			vect[i] = sc.nextDouble();

		}

		sc.close();

	}
}
