package entities;

public class Product {
	public String name;
	public double price;
	public int quantity;

	public double totalValueInStock() {
		Double valueEstoque = (price * quantity);
		return valueEstoque;
	}

	public void addProductsInStock(int quantity) {
		quantity += quantity;
	}

	public void removeQuantityStock(int quantity) {
		quantity -= quantity;
	}
}
