package application;

import java.util.Locale;
import java.util.Scanner;

public class ProjectMatrizFull {

	public static void main(String[] args) {

		Locale.setDefault(Locale.US);
		Scanner sc = new Scanner(System.in);

		System.out.println("Informe a quantidade de linhas e colunas da matriz: ");
		int nLinhas = sc.nextInt();
		int nColun = sc.nextInt();
		int[][] mat = new int[nLinhas][nColun];

		// for percorrer linhasxcolunas
		for (int i = 0; i < mat.length; i++) {
			for (int j = 0; j < mat[j].length; j++) {
				mat[i][j] = sc.nextInt();
			}
		}
		System.out.println();
		System.out.println("Main diagonal: ");

		System.out.println("LinhasxColunas: " + nLinhas + " " + nColun);

		sc.close();

	}
}
