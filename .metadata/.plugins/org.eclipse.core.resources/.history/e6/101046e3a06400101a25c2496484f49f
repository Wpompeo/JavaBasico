package application;

import java.util.Locale;
import java.util.Scanner;

public class NumberReader {

	static int MAX_READER_NUMBER = 10;

	public static void main(String[] args) {

		Locale.setDefault(Locale.US);
		Scanner sc = new Scanner(System.in);
		System.out.println("");
		System.out.println("========Bem vindo ao leitor de números========");
		System.out.println("");
		System.out.println("Quantos números você deseja digita? ");
		int quantNum = sc.nextInt();

		if (quantNum > MAX_READER_NUMBER) {
			System.out.println("Quantidade de números a digitar, é acima do permitido.");
		} else {
			int[] vect = new int[quantNum];

			for (int i = 0; i < vect.length; i++) {
				sc.nextLine();
				System.out.println("Informe o número da posição: " + i);
				vect[i] = sc.nextInt();

			}
			
			for (int j = 0; j < vect.length; j++) {
				
				if (vect[j] < 0) {
					System.out.println("Número da posicão" + j + " é negativo: " + vect[j]);
				} else {
					System.out.println("Número da posição" + j + " é positivo: " + vect[j]);
				}
				System.out.println("");
				System.out.println("===============FIM===============");
			}
		}
		sc.close();
	}
}
