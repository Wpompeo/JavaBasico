package application;

import java.util.Locale;
import java.util.Scanner;

import entities.Product;

public class InventoryControl {

	public void main (String[] args) {
		
		Locale.setDefault(Locale.US);
		Scanner sc = new Scanner(System.in);		
		
		Product product = new Product();
		
		System.out.println("================================");
		System.out.println("Bem vindo ao controle e estoque.");
		System.out.println("================================");
		System.out.println("");
		System.out.println("Informe com o nome do produto:");
		product.name = sc.nextLine();
		System.out.println("Informe com o valor do produto:");
		product.price = sc.nextDouble();
		System.out.println("Informe com a quantidade de produto:");
		product.quantity = sc.nextInt();
		
		System.out.println(product.name + product.price + product.quantity);
		
		
		
		
		
		
		sc.close();
		
	}
}
