import java.util.Scanner;

public class RevelaMaior {
	
	public static void main (String [] args) {
		
		Scanner sc = new Scanner(System.in);
		String numberOne;
		String numberTwo;
		String numberThree;
		
		do {
			System.out.println("=============================================");
			System.out.println("=====Descobrino o MAIOR número digitado!=====");
			System.out.println("Informe o primiero número:");
			System.out.println("Informe o segundo número:");
			System.out.println("Informe o terceiro número:");
			
			numberOne = sc.nextLine();
			numberTwo = sc.nextLine();
			numberThree = sc.nextLine();
			
		}while(!isDouble(numberOne || numberTwo || numberThree));
		
	}

	private static boolean isDouble(String numberThree) {
		try {
            Double.parseDouble(numberThree);
            return true;
        } catch (NumberFormatException e) {
            return false;
        }
	}

}
