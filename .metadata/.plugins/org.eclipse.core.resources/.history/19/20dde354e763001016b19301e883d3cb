package application;

import java.util.Locale;
import java.util.Scanner;

import entities.ProductsVector;

public class Products {

	public static void main(String[] args) {
		Locale.setDefault(Locale.US);
		Scanner sc = new Scanner(System.in);

		System.out.println("Informe a quantidade de produtos que deseja calcular a média de preço: ");
		int n = sc.nextInt();
		ProductsVector[] vect = new ProductsVector[n];
		
		for(int i=0; i<n; i++) {
			sc.nextLine();
			System.out.println("Informe o nome do produto: " + n);
			String producName = sc.nextLine();
			System.out.println("Informe o preço do produto: " + n);
			double priceProduct = sc.nextDouble();
			vect[i] = new ProductsVector(producName, priceProduct);
			
		}
	}

}
