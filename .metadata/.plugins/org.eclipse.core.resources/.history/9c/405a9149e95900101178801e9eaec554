import java.util.Locale;
import java.util.Scanner;

public class ConverterTemperature {

	public static void main(String[] args) {
		Locale.setDefault(Locale.US);
		Scanner sc = new Scanner(System.in);
		char optionTemp;

		System.out.println("=======Bem vindo ao conversor de temperatura C°/F°======");
		System.out.println("Informe a temperatura atual:");
		double tempAtual = sc.nextDouble();
		converterTemp(tempAtual);

		do {
			System.out.println("Deseja descobrir outras temperaturas convertidas? (s/n)");
			optionTemp = sc.next().charAt(0);
			if ( optionTemp !='s') {
				System.out.println("Certo, você não quer realizar mais conversões.");
			}else if( optionTemp =='s'){
				System.out.println("Digite a nova temperatura para conversão:");
				double newTemp = sc.nextDouble();
				double convertTemp = 9.0 * newTemp / 5.0 + 32.0;
				System.out.printf("Nova temperatura convertida para Fahrenheit: %.1f%n" ,convertTemp);				
			}		
			
		}while (optionTemp !='s');
		
	}
	public static double converterTemp(double temp) {

		double tempCelsius = temp;
		double tempFahr = (temp * 1.8) + 32;
		System.out.printf("Sua temperatura atual %.1f°C convertida em Fahrenheit é: %.2f°F \n", tempCelsius, tempFahr);
		return tempFahr;
	}

}
