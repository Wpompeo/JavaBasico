import java.util.Locale;
import java.util.Scanner;

public class ConverterTemperature {
	
	public static void main(String[] args) {
		Locale.setDefault(Locale.US);
		Scanner sc = new Scanner(System.in);
		
		System.out.println("=======Bem vindo ao conversor de temperatura C°/F°======");
		System.out.println("Informe a temperatura atual:");
		double tempAtual = sc.nextDouble();
		converterTemp(tempAtual);
		
		System.out.println("Deseja descobrir outras temperaturas convertidas? (s/n)");
		char optionString = sc.next().charAt(0);
		
		if(optionString == 's') {
			System.out.println("Certo, vamos converter outras temperaturas.");
			System.out.println("Informe a temperatura que deseja converter:");
			System.out.println("");
			
		}else {
			System.out.println("Tudo bem, você não deseja converter temperaturas.");
		}
		
		
		sc.close();
	}
	
	public static double converterTemp(double temp) {
		
		double tempCelsius = temp;
		double tempFahr = ( temp * 1.8) + 32;
		System.out.printf("Sua temperatura atual %.1f °C convertida em Fahrenheit é: %.2f °F ",tempCelsius,tempFahr);
		return tempFahr;
	}

}
