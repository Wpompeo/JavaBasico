package application;

import java.util.Locale;
import java.util.Scanner;

import entities.TransactionBank;

public class Bank {

	static double deposInit;
	static double saqueCont;

	public static void main(String[] args) {
		Locale.setDefault(Locale.US);
		Scanner sc = new Scanner(System.in);

		System.out.println("========Bem vindo ao sistema de cadastro de contas========");
		System.out.println("");
		System.out.println("Informe o número da sua conta: ");
		String conta = sc.nextLine();
		System.out.println("Informe seu nome: ");
		String name = sc.nextLine();
		System.out.println("Gostaria de realizar deposito inicial (s/n)?");
		String depositoInit = sc.nextLine();

		if (depositoInit.equals("s")) {
			System.out.println("Informe o valor que deseja depositar: ");
			deposInit = sc.nextDouble();

		} else {
			System.out.println("Ok! vamos finalizar sua conta sem deposito.");

		}
		double saldo = deposInit;

		TransactionBank transactionBank = new TransactionBank(conta, name, saldo, deposInit);

		transactionBank.initDepos(deposInit);

		System.out.println("Dados da conta:");
		System.out.println("");
		System.out.printf("Conta: %s, Nome: %s, Saldo %.2f%n", conta, name, saldo);
		System.out.println("");

		System.out.println("Você gostaria de realizar algum saque (s/n)?");
		String saqueStatus = sc.nextLine();		

		if (saqueStatus.equals("s")) {
			System.out.println("Informe o valor que deseja sacar de sua conta: ");
			saqueCont = sc.nextDouble();
			transactionBank.saque(saqueCont);
		} else {
			System.out.println(" Certo, você não deseja realizar saque.");
		}
		transactionBank.setSaldo(saqueCont);

		System.out.println("Dados da conta:");
		System.out.println("");
		System.out.printf("Conta: %s, Nome: %s, Saldo %.2f%n", conta, name, saldo);

		sc.close();
	}

}
